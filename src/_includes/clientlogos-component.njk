{# Modular Client Logos Component for 360spaces #}
<link rel="stylesheet" href="/clientlogos.component.css?v=20250919">
    <section class="clientlogos-component-section">
        <div class="clientlogos-component-container">
            <div class="clientlogos-component-header">
                <h2 class="clientlogos-component-title">Trusted by Industry Leaders</h2>
                <p class="clientlogos-component-subtitle">Forward-thinking managers, brands and organisations trust us to create
                    high-impact virtual tours that showcase, plan, and transform their spaces.</p>
            </div>
            <!-- Seamless Scrolling Logo Rail (Marquee) -->
            <section class="clientlogos-component-logos-section">
                <div class="clientlogos-component-logos-marquee">
                    <div class="clientlogos-component-logos-marquee-wrapper">
                        <div class="clientlogos-component-logos-marquee-fade clientlogos-component-logos-marquee-fade--left"></div>
                        <ul class="clientlogos-component-logos-list">
                            {% set logos = [
              {src: 'aston_2.svg', alt: 'Aston Martin'},
              {src: 'toyota_2.svg', alt: 'Toyota'},
              {src: 'hyundai_1.svg', alt: 'Hyundai'},
              {src: 'skoda_1.svg', alt: 'Skoda'},
              {src: 'hilti_1.svg', alt: 'Hilti'},
              {src: 'decathlon_1.svg', alt: 'Decathlon'},
              {src: 'bandq_1.svg', alt: 'B&Q'},
              {src: 'sse_1.svg', alt: 'SSE Arena Belfast'},
              {src: 'w5_2.svg', alt: 'W5 Belfast'},
              {src: 'niscreen_1.svg', alt: 'Northern Ireland Screen'},
              {src: 'goh_2.svg', alt: 'Game of Thrones'},
              {src: 'ea.svg', alt: 'Education Authority'},
              {src: 'lyric_1.svg', alt: 'Lyric Theatre'},
              {src: 'odyssey_1.svg', alt: 'Odyssey'},
              {src: 'spar_1.svg', alt: 'Spar'},
              {src: 'ramada_1.svg', alt: 'Ramada'},
              {src: 'harcourt_1.svg', alt: 'Harcourt'},
              {src: 'tourism.svg', alt: 'NI Tourism'},
              {src: 'bcc_1.svg', alt: 'Belfast City Council'},
              {src: 'victim_1.svg', alt: 'Victim Support NI'},
              {src: 'google.svg', alt: 'Google'},
              {src: 'fitz_1.svg', alt: 'Fitzwilliam Hotel'}
            ] %}
                            {# Repeat the logo set three times for a seamless scroll #}
                            {% for i in [0,1,2] %}
                                {% for logo in logos %}
                                    <li><img src="images/clientlogos/{{ logo.src }}" alt="{{ logo.alt }}" loading="lazy"/></li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                        <div class="clientlogos-component-logos-marquee-fade clientlogos-component-logos-marquee-fade--right"></div>
                    </div>
                </div>
            </section>
            <div class="clientlogos-component-stats">
                <div class="clientlogos-component-stat-item">
                    <div class="clientlogos-component-stat-number">50+</div>
                    <div class="clientlogos-component-stat-label">Industry Leaders</div>
                </div>
                <div class="clientlogos-component-stat-divider"></div>
                <div class="clientlogos-component-stat-item">
                    <div class="clientlogos-component-stat-number">12</div>
                    <div class="clientlogos-component-stat-label">Industry Sectors</div>
                </div>
                <div class="clientlogos-component-stat-divider"></div>
                <div class="clientlogos-component-stat-item">
                    <div class="clientlogos-component-stat-number">200+</div>
                    <div class="clientlogos-component-stat-label">Spaces Transformed</div>
                </div>
            </div>
        </div>
    </section>