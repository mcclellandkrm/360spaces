<section class="luxury-client-showcase client-showcase--light-bg">
  <div class="luxury-client-container" style="padding: 0; margin: 0;">
    <div class="luxury-client-header">
      <h2 class="luxury-client-title">Trusted by Industry Leaders</h2>
      <p class="luxury-client-subtitle">Forward-thinking managers, brands and organisations trust us to create high-impact
        virtual tours that showcase, plan, and transform their spaces.</p>
    </div>
    <!-- Seamless Scrolling Logo Rail (Marquee) -->
    <section class="client-logos-section">
      <div class="client-logos-marquee">
        <div class="client-logos-marquee-wrapper">
          <div class="client-logos-marquee-fade client-logos-marquee-fade--left"></div>
          <ul class="client-logos-list">
            {% set logos = [
                                    {src: 'aston_2.svg', alt: 'Aston Martin'},
                                    {src: 'toyota_2.svg', alt: 'Toyota'},
                                    {src: 'hyundai_1.svg', alt: 'Hyundai'},
                                    {src: 'skoda_1.svg', alt: 'Skoda'},
                                    {src: 'hilti_1.svg', alt: 'Hilti'},
                                    {src: 'decathlon_1.svg', alt: 'Decathlon'},
                                    {src: 'bandq_1.svg', alt: 'B&Q'},
                                    {src: 'sse_1.svg', alt: 'SSE Arena Belfast'},
                                    {src: 'w5_2.svg', alt: 'W5 Belfast'},
                                    {src: 'niscreen_1.svg', alt: 'Northern Ireland Screen'},
                                    {src: 'goh_2.svg', alt: 'Game of Thrones'},
                                    {src: 'ea.svg', alt: 'Education Authority'},
                                    {src: 'lyric_1.svg', alt: 'Lyric Theatre'},
                                    {src: 'odyssey_1.svg', alt: 'Odyssey'},
                                    {src: 'spar_1.svg', alt: 'Spar'},
                                    {src: 'ramada_1.svg', alt: 'Ramada'},
                                    {src: 'harcourt_1.svg', alt: 'Harcourt'},
                                    {src: 'tourism.svg', alt: 'NI Tourism'},
                                    {src: 'bcc_1.svg', alt: 'Belfast City Council'},
                                    {src: 'victim_1.svg', alt: 'Victim Support NI'},
                                    {src: 'google.svg', alt: 'Google'},
                                    {src: 'fitz_1.svg', alt: 'Fitzwilliam Hotel'}
                                ] %}
            {# Repeat the logo set three times for a seamless scroll #}
            {% for i in [0,1,2] %}
              {% for logo in logos %}
                <li><img src="images/clientlogos/{{ logo.src }}" alt="{{ logo.alt }}" loading="lazy"/></li>
              {% endfor %}
            {% endfor %}
          </ul>
          <div class="client-logos-marquee-fade client-logos-marquee-fade--right"></div>
        </div>
      </div>
    </section>
    <div class="luxury-client-stats">
      <div class="luxury-stat-item">
        <div class="luxury-stat-number">50+</div>
        <div class="luxury-stat-label">Industry Leaders</div>
      </div>
      <div class="luxury-stat-divider"></div>
      <div class="luxury-stat-item">
        <div class="luxury-stat-number">12</div>
        <div class="luxury-stat-label">Industry Sectors</div>
      </div>
      <div class="luxury-stat-divider"></div>
      <div class="luxury-stat-item">
        <div class="luxury-stat-number">200+</div>
        <div class="luxury-stat-label">Spaces Transformed</div>
      </div>
    </div>
  </div>
</section>