<section class="luxury-vertical-showcase">
  <div class="parallax-background organic-bubbles"></div>
  <div class="luxury-showcase-container">
    <div class="luxury-showcase-header">
      <h2 class="luxury-showcase-title">Beyond Tours.<br>Pure Transformation.</h2>
      <p class="luxury-showcase-subtitle">Discover how 360° technology transforms the way you see, plan, and optimize your
        spaces</p>
    </div>
    <div
      class="luxury-vertical-cards">
      <!-- Card 1: Security Intelligence -->
      <div class="luxury-vertical-card luxury-card-1">
        <div class="luxury-card-content">
          <div class="luxury-card-icon">
            <img src="{{ '/images/pinpoint.svg' | url }}" alt="Security Search Icon" style="width: 80px; height: 80px;">
          </div>
          <div class="luxury-card-text">
            <span class="luxury-card-eyebrow">Security & Risk Assessment</span>
            <h3 class="luxury-card-title">Pinpoint Problems, Prevent Pitfalls</h3>
            <p class="luxury-card-description">
              Proactively identify layout inefficiencies, security vulnerabilities, and logistical bottlenecks. From footfall patterns
              to fire exits, gain a comprehensive view to spot issues before they escalate.
            </p>
          </div>
        </div>
      </div>
      <!-- Card 2: Strategic Planning -->
      <div class="luxury-vertical-card luxury-card-2">
        <div class="luxury-card-content">
          <div class="luxury-card-icon">
            <lottie-player src="{{ '/images/timeline.json' | url }}" background="transparent" speed="1" style="width: 80px; height: 80px;" loop="loop" autoplay="autoplay"></lottie-player>
          </div>
          <div class="luxury-card-text">
            <span class="luxury-card-eyebrow">Strategic Planning</span>
            <h3 class="luxury-card-title">Decision-Making, Elevated</h3>
            <p class="luxury-card-description">
              Simulate and analyze changes to optimize layouts, product placement, and operational flow. Test scenarios virtually to
              ensure every strategic choice delivers maximum impact.
            </p>
          </div>
        </div>
      </div>
      <!-- Card 3: Training & Onboarding -->
      <div class="luxury-vertical-card luxury-card-3">
        <div class="luxury-card-content">
          <div class="luxury-card-icon">
            <img src="{{ '/images/training.svg' | url }}" alt="Security Search Icon" style="width: 80px; height: 80px;">
          </div>
          <div class="luxury-card-text">
            <span class="luxury-card-eyebrow">Training & Onboarding</span>
            <h3 class="luxury-card-title">Immersive Learning That Sticks</h3>
            <p class="luxury-card-description">
              Rapidly train new team members with immersive virtual tours of your entire operation. Provide comprehensive, risk-free
              orientation to safety protocols and operational procedures.
            </p>
          </div>
        </div>
      </div>
      <!-- Card 4: Future-Proofing -->
      <div class="luxury-vertical-card luxury-card-4">
        <div class="luxury-card-content">
          <div class="luxury-card-icon">
            <img src="{{ '/images/planning.svg' | url }}" alt="Security Search Icon" style="width: 80px; height: 80px;">
          </div>
          <div class="luxury-card-text">
            <span class="luxury-card-eyebrow">Future-Proofing</span>
            <h3 class="luxury-card-title">Strategic Planning, Simplified</h3>
            <p class="luxury-card-description">
              Effortlessly map out future renovations, security upgrades, and new integrations. Visualize and collaborate on
              modifications without ever leaving the office.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const parallaxElement = document.querySelector('.parallax-background');
    if (parallaxElement) {
      function updateParallax() {
        const scrolled = window.pageYOffset;
        const section = document.querySelector('.luxury-vertical-showcase');
        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;
        const windowHeight = window.innerHeight;
        // Only animate when section is in view
        if (scrolled + windowHeight > sectionTop && scrolled < sectionTop + sectionHeight) {
          const yPos = -(scrolled - sectionTop) * 0.3;
          parallaxElement.style.transform = `translate3d(0, ${yPos}px, 0)`;
        }
      }
      // Throttle scroll events for better performance
      let ticking = false;
      function requestTick() {
        if (! ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }
      window.addEventListener('scroll', function () {
        requestTick();
        ticking = false;
      });
      // Initial call
      updateParallax();
      // Developer tool for testing different parallax styles Use in browser console: switchParallax('flowing-waves')
      window.switchParallax = function (style) {
        const styles = [
          'geometric-mesh',
          'flowing-waves',
          'hexagonal',
          'organic-bubbles',
          'circuit-board'
        ];
        parallaxElement.className = 'parallax-background ' + (
          styles.includes(style)
          ? style
          : 'geometric-mesh');
        console.log('Switched to parallax style:', style);
      };
      // List all available styles
      window.listParallaxStyles = function () {
        console.log('Available parallax styles:');
        console.log('1. geometric-mesh (current default)');
        console.log('2. flowing-waves');
        console.log('3. hexagonal');
        console.log('4. organic-bubbles');
        console.log('5. circuit-board');
        console.log('Usage: switchParallax("style-name")');
      };
      console.log('Parallax developer tools loaded. Type listParallaxStyles() to see options.');
    }
  });
</script>