<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {% if title %}
        {{ title }} |
      {% endif %}360spaces - Virtual Tours & Space Technology Solutions</title>
    <meta
      name="description"
      content="Transform your spaces with 360° virtual tour technology. Professional virtual tours, space analysis, and
        immersive experiences for businesses across Ireland and the UK.">
    <meta
      name="keywords"
      content="360 virtual tours, virtual reality, space technology, VR tours, property tours, business tours, 360 photography,
        immersive experiences">
    <meta name="author" content="360spaces">
    <meta property="og:title" content="360spaces - Virtual Tours & Space Technology Solutions">
    <meta
      property="og:description"
      content="Transform your spaces with professional 360° virtual tour technology. Immersive experiences for businesses
        across Ireland and the UK.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://360spaces.co.uk">
    <meta property="og:site_name" content="360spaces">
    <link rel="canonical" href="https://360spaces.co.uk{{ page.url }}">
    <link rel="stylesheet" href="{{ '/style.css' | url }}?v=20250916">
  </head>
  <body>
    {% include "navbar.njk" %}
    <main>
      {{ content | safe }}
    </main>
    {# === Mouse Trail Effect START (removable, brand-aligned) === #}
    <div id="main-dot-mousetrail" class="trail-dot-mousetrail main-dot-mousetrail"></div>
    <script>
      (function () { // Hide on touch devices
        if ('ontouchstart' in window) 
          return;
        
        const NUM_TRAIL = 12; // Fewer dots for subtlety
        const trail = [];
        for (let i = 0; i < NUM_TRAIL; i++) {
          const el = document.createElement('div');
          el.className = 'trail-dot-mousetrail';
          document.body.appendChild(el);
          trail.push({
            el,
            x: window.innerWidth / 2,
            y: window.innerHeight / 2
          });
        }
        const mainDot = document.getElementById('main-dot-mousetrail');
        let mouseX = window.innerWidth / 2,
          mouseY = window.innerHeight / 2;
        document.addEventListener('mousemove', e => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });
        function animate() {
          mainDot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
          let prevX = mouseX,
            prevY = mouseY;
          for (let i = 0; i < trail.length; i++) {
            const t = trail[i];
            t.x += (prevX - t.x) * 0.25;
            t.y += (prevY - t.y) * 0.25;
            t
              .el
              .style
              .transform = `translate(${
              t.x
            }px, ${
              t.y
            }px)`;
            // Brand-aligned fade and blur
            const opacity = 0.10 + 0.35 * (1 - i / trail.length);
            const blur = 0.5 + 1.5 * (i / trail.length);
            t
              .el
              .style
              .opacity = opacity;
            t
              .el
              .style
              .filter = `blur(${blur}px)`;
            prevX = t.x;
            prevY = t.y;
          }
          requestAnimationFrame(animate);
        }
        animate();
      })();
    </script>
    <style>
      .trail-dot-mousetrail {
        position: fixed;
        top: 0;
        left: 0;
        width: 7px;
        height: 7px;
        background: linear-gradient(90deg, #6c5ce7 0%, #00b894 100%);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        will-change: transform, opacity, filter;
      }
      .main-dot-mousetrail {
        width: 3px;
        height: 3px;
        background: #fff;
        border: 2px solid #6c5ce7;
        box-shadow: 0 0 4px #6c5ce7;
      }
    </style>
    {# === Mouse Trail Effect END (removable, brand-aligned) === #}
  </body>
</html>