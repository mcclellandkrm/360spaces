                        <ul class="project-features-list">
                            <li>
                                <strong>Room Previews:</strong>
                                Virtual room tours for enhanced booking confidence</li>
                            <li>
                                <strong>Venue Showcases:</strong>
                                Event spaces and dining areas for planners</li>
                            <li>
                                <strong>Guest Services:</strong>
                                Virtual concierge and amenity discovery</li>
                        </ul>
                        <div class="project-status">
                            <span class="status-badge planning">Planning Phase</span>
                            <span class="project-timeline">Capture scheduled: Q1 2026</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="projects-panel" id="tesco-panel">
