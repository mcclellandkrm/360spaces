<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.projects-tab');
    const panels = document.querySelectorAll('.projects-panel');
    tabs.forEach(tab => {
      tab.addEventListener('click', function () {
        const projectId = this.getAttribute('data-project');
        // Remove active class from all tabs and panels
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        // Add active class to clicked tab and corresponding panel
        this.classList.add('active');
        document
          .getElementById(projectId + '-panel')
          .classList
          .add('active');
      });
    });
    // Add smooth scroll behavior for tab navigation
    const tabsContainer = document.querySelector('.projects-tabs-nav');
    if (tabsContainer) {
      tabsContainer.addEventListener('wheel', function (e) {
        if (e.deltaY !== 0) {
          e.preventDefault();
          this.scrollLeft += e.deltaY;
        }
      });
    }
  });
</script>