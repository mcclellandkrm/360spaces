                            <li>
                                <strong>Customer Journey:</strong>
                                Shopping flow analysis and optimisation</li>
                            <li>
                                <strong>Space Planning:</strong>
                                Store, stock and car park layout</li>
                            <li>
                                <strong>Staff Onboarding:</strong>
                                Comprehensive store familiarization training</li>
                        </ul>
                        <div class="project-status">
                            <span class="status-badge discovery">Discovery Phase</span>
                            <span class="project-timeline">Requirements gathering: Q4 2025</span>
